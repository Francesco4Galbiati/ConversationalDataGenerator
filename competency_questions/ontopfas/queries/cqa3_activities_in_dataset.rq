# Supporting question. Which activity sites are reported in a given dataset?
PREFIX ontopfas: <https://w3id.org/OntoPFAS#>
PREFIX schema: <https://schema.org/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dcat3: <https://www.w3.org/TR/vocab-dcat-3/#Property:>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT DISTINCT ?activity WHERE {
  VALUES ?dataset { <urn:healtheqkg:replace:dataset> }
  ?activity a schema:Organization ; dcterms:source ?dataset .
}
